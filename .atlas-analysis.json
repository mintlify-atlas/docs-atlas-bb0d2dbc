  "keyFeatures": [
    "Subscribe and manage podcast feeds (RSS/Atom)",
    "Download episodes for offline listening",
    "Background audio playback with media controls",
    "Variable playback speed",
    "Episode queue and inbox management",
    "Chromecast support (Google Play flavor)",
    "Podcast discovery via iTunes, fyyd, and other directories",
    "Synchronization via Gpodder.net",
    "OPML import/export for feed lists",
    "Full database backup and restore",
    "Home screen widget",
    "Yearly listening rewind (Echo)",
    "Episode transcripts display",
    "Chapter support with navigation",
    "Statistics and listening history"
  ],
  "publicApiSurface": [
    "Feed (model class for podcast subscriptions)",
    "FeedItem (model class for podcast episodes)",
    "FeedMedia (model class for episode audio/video files)",
    "Chapter (model class for episode chapters)",
    "DBWriter (async database write operations)",
    "PodDBAdapter (SQLite database adapter)",
    "UserPreferences (user settings access)",
    "ClientConfigurator (service registration at startup)",
    "EpisodeDownloadWorker (background download via WorkManager)",
    "FeedUpdateWorker (feed refresh via WorkManager)",
    "PlaybackService (media playback service)",
    "SyncService (external sync service)",
    "ISyncService (sync backend interface)",
    "OPML import/export (feed list interchange)",
    "SubscriptionSearch (podcast discovery interface)"
  ]
}
